digraph {
	graph [fontname=Helvetica label="Schema and table checks" labelloc=t nodesep=0.3 rankdir=LR ranksep=0.6]
	node [fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [fontname=Helvetica fontsize=9]
	subgraph cluster_scope {
		color=gray70 label="Row condition: All rows"
		expectation_0 [label="1. ExpectTableColumnsToMatchSet" fillcolor=aliceblue tooltip=flow_comparison_required_columns]
		comparison [label="Comparison table" fillcolor=whitesmoke]
		comparison -> expectation_0 [label=table]
	}
}
