digraph {
	graph [fontname=Helvetica label="Identity checks" labelloc=t nodesep=0.3 rankdir=LR ranksep=0.6]
	node [fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [fontname=Helvetica fontsize=9]
	subgraph cluster_scope {
		color=gray70 label="Row condition: All rows"
		expectation_1 [label="2. ExpectColumnValuesToNotBeNull" fillcolor=aliceblue tooltip=rollup_expected_account_id_is_present]
		column_0 [label="expected_account_id
string" fillcolor=honeydew]
		column_0 -> expectation_1 [label=column]
		expectation_2 [label="3. ExpectColumnValuesToNotBeNull" fillcolor=aliceblue tooltip=rollup_person_contact_id_is_present]
		column_1 [label="person_contact_id
string" fillcolor=honeydew]
		column_1 -> expectation_2 [label=column]
		expectation_3 [label="4. ExpectColumnValuesToNotBeNull" fillcolor=aliceblue tooltip=rollup_observed_account_id_is_present]
		column_2 [label="observed_account_id
string" fillcolor=honeydew]
		column_2 -> expectation_3 [label=column]
		expectation_4 [label="5. ExpectColumnValuesToBeUnique" fillcolor=aliceblue tooltip=one_rollup_comparison_row_per_person_account]
		column_0 -> expectation_4 [label=column]
	}
}
